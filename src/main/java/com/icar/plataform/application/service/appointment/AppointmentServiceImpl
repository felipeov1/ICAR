                .toList();
    }

    @Override
    @Transactional(readOnly = true)
    public List<AppointmentResponse> findByCarWashId(UUID carWashId) {
        return appointmentRepository.findByCarWashId(carWashId)
                .stream()
                .map(mapper::toDto)
                .toList();
    }

    @Override
    @Transactional
    public void cancel(UUID id) {
        Appointment appointment = appointmentRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Appointment not found"));

        validateCancellationTime(appointment.getDateTime());

        appointment.setStatus(AppointmentStatus.CANCELED);
        appointmentRepository.save(appointment);
        log.info("Appointment canceled: {}", id);
    }

    @Override
    @Transactional
    public AppointmentResponse reschedule(UUID id, LocalDateTime newDateTime) {
        Appointment appointment = appointmentRepository.findById(id)
                .orElseThrow(() -> new ResourceNotFoundException("Appointment not found"));

        validator.validateReschedule(appointment, newDateTime);

        appointment.setDateTime(newDateTime);
        Appointment updated = appointmentRepository.save(appointment);

        return mapper.toDto(updated);
    }

    // Métodos auxiliares privados
    private void calculateFinalPrice(Appointment appointment, com.icar.plataform.domain.model.carwash.CarWashOffering service) {
        Optional<Promotion> activePromotion = promotionRepository.findByServiceIdAndStartDateBeforeAndEndDateAfter(
                service.getId(),
                LocalDateTime.now(),
                LocalDateTime.now()
        );

        BigDecimal finalPrice = activePromotion
                .map(promo -> {
                    BigDecimal discountPercentage = promo.getDiscount().divide(
                            BigDecimal.valueOf(100),
                            MathContext.DECIMAL128 // or another appropriate rounding mode
                    );
                    return service.getPrice().multiply(BigDecimal.ONE.subtract(discountPercentage));
                })
                .orElse(service.getPrice());

        appointment.setAmountPaid(finalPrice);
    }

    private void checkTimeSlotAvailability(UUID carWashId, LocalDateTime dateTime) {
        boolean isSlotAvailable = !appointmentRepository.existsByCarWashIdAndDateTimeBetween(
                carWashId,
                dateTime.minusHours(1),
                dateTime.plusHours(1)
        );

        if (!isSlotAvailable) {
            throw new BusinessException("Time slot not available");
        }
    }

    private void checkBusinessHours(CarWash carWashRegistration, LocalDateTime dateTime) {
        // Implementação da verificação de horário comercial
        // Você precisará adicionar a lógica específica para seu negócio
        if (dateTime.getHour() < 8 || dateTime.getHour() > 18) {
            throw new BusinessException("Outside business hours");
        }
    }

    private void validateCancellationTime(LocalDateTime appointmentTime) {
        if (LocalDateTime.now().plusHours(12).isAfter(appointmentTime)) {
            throw new BusinessException("Cancellation must be done at least 12 hours in advance");
        }
    }
