    @Override
    @Transactional
    public AppointmentResponse create(AppointmentRequest dto) {

        validator.validateCreate(dto);

        Customer customer = customerRepository.findById(dto.customerId())
                .orElseThrow(() -> new ResourceNotFoundException("Customer not found"));

        CarWash carWashRegistration = carWashRepository.findById(dto.carWashId())
                .orElseThrow(() -> new ResourceNotFoundException("Car wash not found"));

        com.icar.plataform.domain.model.Service service = serviceRepository.findById(dto.serviceId())
                .orElseThrow(() -> new ResourceNotFoundException("Service not found"));

        checkTimeSlotAvailability(carWashRegistration.getId(), dto.dateTime());
        checkBusinessHours(carWashRegistration, dto.dateTime());

        Appointment appointment = mapper.toEntity(dto);
        calculateFinalPrice(appointment, service);

        Appointment saved = appointmentRepository.save(appointment);
        log.info("Appointment created: {}", saved.getId());

        return mapper.toDto(saved);
    }

    @Override
    @Transactional(readOnly = true)
    public AppointmentResponse findById(UUID id) {
        return appointmentRepository.findById(id)
                .map(mapper::toDto)
                .orElseThrow(() -> new ResourceNotFoundException("Appointment not found"));
    }

    @Override
