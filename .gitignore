### Project Files ###
HELP.md
target/                  # Maven build directory
!.mvn/wrapper/maven-wrapper.jar  # Keep the Maven wrapper JAR
!**/src/main/**/target/  # Allow target in src/main (if needed)
!**/src/test/**/target/  # Allow target in src/test (if needed)

### Build Tools ###
build/                   # Gradle build directory
!**/src/main/**/build/   # Allow build in src/main (if needed)
!**/src/test/**/build/   # Allow build in src/test (if needed)

### IDE Specific ###
# STS/Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# IntelliJ
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### Environment ###
.env                     # Local environment files
.env.local
.env*.local


### Configuration Files ###
/config/application-*.properties  # Ignore all environment-specific property files
!application.properties           # Keep main application.properties

### Node.js ###
**/node_modules/         # Node.js dependencies

